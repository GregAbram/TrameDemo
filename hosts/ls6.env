# Lonestar6 settings for install_trame_jupyter.sh (sourced by it).
# Each can be overridden with an environment variable of the same name.

# ParaView osmesa install (must contain bin/pvpython): no default yet, set PV
PV=${PV:-}
PV_MODULES=${PV_MODULES:-"gcc/13.2 impi/21.18"}
# The venv uses ParaView's bundled Python (SYSPY empty = ${PV}/bin/python3.12
# or python3), so no Python module
PYTHON_MODULE=${PYTHON_MODULE-}
SYSPY=${SYSPY:-}
